#
# The firmware for mediatekwifi, from OpenBSD's mwx-firmware package. The
# blobs are fetched from the versioned OpenBSD firmware path, which does not
# rotate, and the archive is checked against a pinned SHA-256.
local mediatekFirmwarePackage = mediatek_wifi_firmwares.hpkg ;
HaikuPackage $(mediatekFirmwarePackage) ;

local archive = [ DownloadFile mwx-firmware-20260309p0.tgz
	: https://firmware.openbsd.org/firmware/7.9/mwx-firmware-20260309p0.tgz
	:
	: 09f6ca765d972e9a2bd28437c6f4b526615587b483f751826bcf53e26e0902ff ] ;

# MT7920 (_1a) and MT7921 (_1). The MT7922 and MT7925 blobs in the same
# archive come with the device IDs that need them.
local directory = [ FDirName $(HAIKU_OPTIONAL_BUILD_PACKAGES_DIR)
	mwx-firmware-20260309p0 ] ;
local firmwareFiles = [ ExtractArchive $(directory:G=mediatek-firmware)
	:
	firmware/mwx-mt7961_patch_mcu_1_2_hdr
	firmware/mwx-mt7961_ram_code_1
	firmware/mwx-mt7961_patch_mcu_1a_2_hdr
	firmware/mwx-mt7961_ram_code_1a
	: $(archive) : extracted-mediatek-firmware ] ;
local licenseFile = [ ExtractArchive $(directory:G=mediatek-firmware)
	: firmware/mwx-license : $(archive) : extracted-mediatek-firmware ] ;

AddFilesToPackage data firmware mediatekwifi : $(firmwareFiles) $(licenseFile) ;
# The license name the package info refers to, shipped with the package.
AddFilesToPackage data licenses : $(licenseFile) : "MediaTek (firmware)" ;

BuildHaikuPackage $(mediatekFirmwarePackage) : mediatek_wifi_firmwares ;
