# Jamfile for a RenkuOS/Haiku tree, to be placed in
# src/add-ons/kernel/file_systems/pcloudfs.
#
# All sources are kept flat so the directory can be copied into the source
# tree without rewriting paths.

SubDir HAIKU_TOP src add-ons kernel file_systems pcloudfs ;

local userlandFSIncludes = [ FDirName $(HAIKU_TOP) headers private
	userlandfs ] ;

UsePrivateHeaders shared ;
SubDirSysHdrs [ FDirName $(userlandFSIncludes) fuse ] ;
SubDirHdrs [ FDirName $(userlandFSIncludes) shared ] ;

DEFINES += USER=1 ;
DEFINES += DEBUG_APP=\\"pcloudfs\\" ;
DEFINES += PACKAGE_VERSION=\\"2.9.9\\" ;

local pcloudCommonSources =
	PCloudAuth.cpp
	PCloudApi.cpp
	PCloudCache.cpp
	PCloudCrypto.cpp
	PCloudHttp.cpp
	PCloudJson.cpp
	PCloudLogger.cpp
	PCloudNode.cpp
;

Addon pcloudfs
	:
	pcloudfs.cpp
	PCloudFileSystem.cpp
	$(pcloudCommonSources)
	:
	libuserlandfs_fuse.so bnetapi be network shared [ TargetLibstdc++ ]
;

Bin pcloudctl
	:
	pcloudctl.cpp
	$(pcloudCommonSources)
	:
	bnetapi be network shared [ TargetLibstdc++ ]
;

# The add-on must be where userlandfs_server looks for it, and the command
# line tool must be in PATH for "pcloudctl setup".
AddFilesToHaikuImage system add-ons userlandfs : pcloudfs ;
AddFilesToHaikuImage system bin : pcloudctl ;
